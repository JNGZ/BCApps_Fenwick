table 'ABC Classification'
	lineageTag: 8ffd963d-31f3-42e9-9ae6-0eee8bcff7b6

	measure 'ABC Sales Amount' =
			
			VAR SalesByProduct =
			    ADDCOLUMNS (
			         SELECTCOLUMNS(ALLSELECTED('Item'),'Item'[Item No.], 'Item'[Item Description], 'Item'[Item No. & Description], 'Item'[Item Category Code]),
			        "@ProdSales", [Sales Amount]
			
			    )
			VAR AllSales =
			    CALCULATE (
			        [Sales Amount],
			        ALLSELECTED ( 'Item' )
			    )
			VAR CumulatedPctByProduct =
			    ADDCOLUMNS (
			        SalesByProduct,
			        "@CumulatedPct",
			        VAR CurrentSalesAmt = [@ProdSales]
			        VAR CumulatedSales =
			            FILTER (
			                SalesByProduct,
			                [@ProdSales] >= CurrentSalesAmt
			            )
			        VAR CumulatedSalesAmount =
			            SUMX (
			                CumulatedSales,
			                [@ProdSales]
			            )
			        RETURN
			            DIVIDE (
			                CumulatedSalesAmount,
			                AllSales
			            )
			    )
			VAR ProductsInClass =
			    FILTER (
			        CROSSJOIN (
			            CumulatedPctByProduct,
			            'ABC Classification'
			        ),
			        AND (
			            [@CumulatedPct] > 'ABC Classification'[Lower Boundary],
			            [@CumulatedPct] <= 'ABC Classification'[Upper Boundary]
			        )
			    )
			VAR Result =
			    CALCULATE (             -- The pattern is the same for every measure, just
			       [Sales Amount],     -- change this measure reference for other measures
			        KEEPFILTERS ( ProductsInClass )
			    )
			RETURN
			    IF(Result = 0, BLANK(), Result)
		formatString: #,0.00
		lineageTag: 1a2887f9-6ab2-489f-824d-ef6f260f60cd

	measure 'No. of Items' = ```
			
			
			var ItemSales =
			    ADDCOLUMNS (
			        SELECTCOLUMNS(ALLSELECTED('Item'),'Item'[Item No.], 'Item'[Item Description], 'Item'[Item No. & Description]),
			        "@Sales", [Sales Amount]
			    )
			var ItemSalesFiltered = 
				FILTER(
					ItemSales,
					[@Sales] > 0
				)
			VAR AllSales =
			    CALCULATE (
			        [Sales Amount],
			        ALLSELECTED ( 'Item' )
			    )
			VAR ItemSalesPerc =
			    ADDCOLUMNS (
			        ItemSalesFiltered,
			        "@AggSales%",
			        VAR CurrentSalesAmt = [@Sales]
			        VAR CumulatedSales =
			            SUMX (
			                FILTER (
			                    ItemSales,
			                    [@Sales] >= CurrentSalesAmt
			                ),
			                [@Sales]
			            )
			        RETURN
			            DIVIDE (
			                CumulatedSales,
			                AllSales
			            )
			    )
			VAR ItemsInClass =
			    FILTER (
			        CROSSJOIN (
			            ItemSalesPerc,
			            'ABC Classification'
			        ),
			        AND (
			            [@AggSales%] > 'ABC Classification'[Lower Boundary],
			            [@AggSales%] <= 'ABC Classification'[Upper Boundary]
			        )
			    )
			VAR Result =
			    CALCULATE (
			        COUNTROWS ( 'Item' ),
			        KEEPFILTERS ( ItemsInClass )
			    )
			RETURN
			    Result
			```
		formatString: 0
		lineageTag: eedc67f5-deca-40fd-a96e-d66453c7fe0c

	measure 'ABC Sales Quantity' =
			
			VAR SalesByProduct =
			    ADDCOLUMNS (
			        ALLSELECTED ( 'Item' ),
			        "@ProdSales", CALCULATE(SUM('Item Ledger Entries'[invoicedQuantity]))
			
			    )
			VAR AllSales =
			    CALCULATE (
			        SUM('Item Ledger Entries'[invoicedQuantity]),
			        ALLSELECTED ( 'Item' )
			    )
			VAR CumulatedPctByProduct =
			    ADDCOLUMNS (
			        SalesByProduct,
			        "@CumulatedPct",
			        VAR CurrentSalesAmt = [@ProdSales]
			        VAR CumulatedSales =
			            FILTER (
			                SalesByProduct,
			                [@ProdSales] >= CurrentSalesAmt
			            )
			        VAR CumulatedSalesAmount =
			            SUMX (
			                CumulatedSales,
			                [@ProdSales]
			            )
			        RETURN
			            DIVIDE (
			                CumulatedSalesAmount,
			                AllSales
			            )
			    )
			VAR ProductsInClass =
			    FILTER (
			        CROSSJOIN (
			            CumulatedPctByProduct,
			            'ABC Classification'
			        ),
			        AND (
			            [@CumulatedPct] > 'ABC Classification'[Lower Boundary],
			            [@CumulatedPct] <= 'ABC Classification'[Upper Boundary]
			        )
			    )
			VAR Result =
			    CALCULATE (             -- The pattern is the same for every measure, just
			       SUM('Item Ledger Entries'[invoicedQuantity]),     -- change this measure reference for other measures
			        KEEPFILTERS ( ProductsInClass )
			    )
			RETURN
			    Result
		lineageTag: e0eaae18-d899-4dcb-ae1a-ecc3685ace3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ABC Percent of Sales' =
			
			VAR AllSales =
			    CALCULATE (
			        [Sales Amount],
			        ALLSELECTED ( 'Item' )
			    )
			RETURN DIVIDE('ABC Classification'[ABC Sales Amount], AllSales)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 05184584-b383-40c7-8379-f6f809c060e6

