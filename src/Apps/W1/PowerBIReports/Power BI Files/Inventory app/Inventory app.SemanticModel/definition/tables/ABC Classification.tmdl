	partition 'ABC Classification' = calculated
		mode: import
		source =
				
				VAR A =
				    MAX ( 'ABC Classes'[categoryA] )
				VAR B =
				    MAX ( 'ABC Classes'[categoryB] )
				VAR C =
				    MAX ( 'ABC Classes'[categoryC] )
				RETURN
				    UNION (
				        ROW ( "ABC Class", "A", "Lower Boundary", 0, "Upper Boundary", DIVIDE(A,100) ),
				        ROW ( "ABC Class", "B", "Lower Boundary", DIVIDE(A,100), "Upper Boundary", DIVIDE(A + B,100) ),
				        ROW ( "ABC Class", "C", "Lower Boundary", DIVIDE(A + B,100), "Upper Boundary", 1 )
				    )

	annotation PBI_Id = 0caf2083755a4793bdd5aaa3409ddb44

